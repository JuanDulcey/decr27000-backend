# Variables de entorno (plantilla segura para compartir en Git: solo marcadores)
# Copie este archivo como .env y reemplace los valores entre corchetes.
# El .env NUNCA se sube al repositorio.

PORT=4000
NODE_ENV=development

# --- Base de datos: Supabase (Session Pooler, región us-east-2) ---
DATABASE_URL=postgresql://postgres.agnkxidlirvkwwfavsvt:[PASSWORD]@aws-0-us-east-2.pooler.supabase.com:5432/postgres
# Conexiones del pool (Render gratuito + Supabase gratuito: mantener bajo)
DB_POOL_MAX=4
# CA de Supabase (Panel → Database → SSL Configuration → Download certificate).
# Pegue el PEM en una sola línea reemplazando los saltos por \n. Si se omite, la conexión
# va cifrada pero sin verificar el certificado (el backend lo advierte en el log).
DB_SSL_CA=

# Variables desglosadas (solo para clientes SQL externos; el backend usa DATABASE_URL)
DB_HOST=aws-0-us-east-2.pooler.supabase.com
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres.agnkxidlirvkwwfavsvt
DB_PASSWORD=[PASSWORD]
DB_SSL=true

SUPABASE_PROJECT_REF=agnkxidlirvkwwfavsvt
SUPABASE_URL=https://agnkxidlirvkwwfavsvt.supabase.co

# --- Seguridad (RNF04) ---
# Genere uno propio con: openssl rand -hex 32   (mínimo 32 caracteres)
JWT_SECRET=[GENERAR_CON_openssl_rand_hex_32]
JWT_EXPIRES_IN=8h

# --- CORS y URLs oficiales ---
# FRONTEND_URL, los previews de Vercel del proyecto y localhost ya están permitidos.
# CORS_ORIGINS admite orígenes extra separados por comas.
CORS_ORIGINS=
FRONTEND_URL=https://decr27000-frontend.vercel.app
BACKEND_URL=https://decr27000-backend.onrender.com

# --- Funciones opcionales ---
# Swagger en /api/docs (en producción está apagado salvo que se active aquí)
SWAGGER_ENABLED=true
# POST /api/seed/reset (solo admin; PLAN B3.4)
ALLOW_SEED_RESET=false
